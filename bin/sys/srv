#!/bin/sh

[ -n "${m_ROOT:-}" ] || { printf '%s\n' 'srv: m environment not initialized' >&2; exit 1; }

. "$m_LIB_DIR/sys/sh/core.lib.sh" || { printf '%s\n' 'srv: m shell runtime unavailable' >&2; exit 2; }

loadsyslib "pkg/pkg-provider"
loadsyslib "pkg/facility/pkg-facility"
loadsyslib "pkg/facility/pkg-dependency"

srv_name_valid()
{
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    "" | [!abcdefghijklmnopqrstuvwxyz0123456789]* | *[!abcdefghijklmnopqrstuvwxyz0123456789._-]* | *[._-]) return 1 ;;
  esac
}

srv_caller_pid_get()
{
  srv_caller_pid="$(command -p -- ps -p "$$" -o ppid= 2>/dev/null | command -p -- awk 'NR == 1 { print $1 }')"
  case "$srv_caller_pid" in '' | *[!0123456789]*) return 1 ;; esac
  [ "$srv_caller_pid" -gt 0 ]
}

srv_paths_prepare()
{
  srv_run_root="$(command -- state-path user sys srv run)" || return 1
  srv_log_root="$(command -- state-path user sys srv log)" || return 1

  umask 077
  command -p -- mkdir -p -- "$srv_run_root" "$srv_log_root" || return 1

  [ -d "$srv_run_root" ] && [ ! -L "$srv_run_root" ] || return 1
  [ -d "$srv_log_root" ] && [ ! -L "$srv_log_root" ] || return 1

  srv_runtime_dir="$srv_run_root/$srv_name"
  srv_log_file="$srv_log_root/$srv_name.log"
}

srv_supervisor_request()
{
  [ "$#" -eq 2 ] || return 2
  srv_supervisor_action=$1
  srv_supervisor_bin="$m_ROOT/libexec/sys/srv-supervisor"
  [ -f "$srv_supervisor_bin" ] && [ -x "$srv_supervisor_bin" ] || \
    fatal 4 srv supervisor-unavailable service "$srv_name" path "$srv_supervisor_bin"
  srv_request_output="$(command -- "$srv_supervisor_bin" --request \
    "$m_ROOT" "$srv_run_root" "$srv_log_file" "$srv_name" \
    "$srv_caller_pid" "$srv_force" "$1" "$m_BOOTSTRAP_BIN" \
    "${srv_command-}" "${srv_provider-}" 2>/dev/null)" || \
    fatal 5 srv supervisor-request-failed service "$srv_name" action "$srv_supervisor_action"
  set -- $srv_request_output
  [ "$#" -eq 2 ] || fatal 6 srv supervisor-response-invalid service "$srv_name" action "$srv_supervisor_action"
  case "$1" in '' | *[!0123456789]*) fatal 6 srv supervisor-response-invalid service "$srv_name" action "$srv_supervisor_action" ;; esac
  case "$2" in '' | *[!0123456789]*) fatal 6 srv supervisor-response-invalid service "$srv_name" action "$srv_supervisor_action" ;; esac
  srv_supervisor_result=$1
  srv_pid=$2
}

srv_start()
{
  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv subcommand start
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv subcommand start service "$srv_name"
  srv_caller_pid_get || fatal 1 execution execution-failed operation srv reason caller-pid-unavailable service "$srv_name"
  srv_paths_prepare || fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"

  srv_force=0
  srv_supervisor_request CHECK "$srv_force"
  case "$srv_supervisor_result" in
    1) printf -- 'srv: %s already running pid=%s\n' "$srv_name" "$srv_pid"; return 0 ;;
    3) : ;;
    5) fatal 7 srv start-runtime-orphaned service "$srv_name" pid "$srv_pid" runtime "$srv_runtime_dir" ;;
    *) fatal 5 srv supervisor-request-failed service "$srv_name" action check result "$srv_supervisor_result" ;;
  esac

  srv_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)" || \
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_command="$(pkg_facility_service_start_resolve "$srv_name" "$srv_provider")" || \
    fatal 1 execution execution-failed operation srv reason service-realization-invalid service "$srv_name" provider "$srv_provider"

  srv_supervisor_request START "$srv_force"
  case "$srv_supervisor_result" in
    0) printf -- 'srv: %s started pid=%s\n' "$srv_name" "$srv_pid" ;;
    1) printf -- 'srv: %s already running pid=%s\n' "$srv_name" "$srv_pid" ;;
    5) fatal 7 srv start-runtime-orphaned service "$srv_name" pid "$srv_pid" runtime "$srv_runtime_dir" ;;
    6) fatal 8 srv start-failed service "$srv_name" provider "$srv_provider" log "$srv_log_file" ;;
    *) fatal 5 srv supervisor-request-failed service "$srv_name" action start result "$srv_supervisor_result" ;;
  esac
}

srv_stop()
{
  srv_force=0
  if [ "${1-}" = -f ]
  then
    srv_force=1
    shift
  fi

  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv subcommand stop
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv subcommand stop service "$srv_name"
  srv_caller_pid_get || fatal 1 execution execution-failed operation srv reason caller-pid-unavailable service "$srv_name"
  srv_paths_prepare || fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"
  srv_supervisor_request STOP "$srv_force"
  case "$srv_supervisor_result" in
    2) printf -- 'srv: %s stopped\n' "$srv_name" ;;
    3) printf -- 'srv: %s not running\n' "$srv_name" ;;
    4)
      printf -- 'srv: %s pid=%s was not started by this caller; leaving it running\n' "$srv_name" "$srv_pid"
      printf -- 'srv: use srv stop -f %s to stop it explicitly\n' "$srv_name"
      ;;
    5) fatal 9 srv stop-runtime-orphaned service "$srv_name" pid "$srv_pid" runtime "$srv_runtime_dir" ;;
    7) fatal 10 srv stop-timeout service "$srv_name" pid "$srv_pid" ;;
    *) fatal 5 srv supervisor-request-failed service "$srv_name" action stop result "$srv_supervisor_result" ;;
  esac
}

srv_host_provider_resolve()
{
  [ "$#" -eq 1 ] || return 2
  srv_name=$1

  srv_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)" || return 1
  srv_command="$(pkg_facility_service_start_resolve "$srv_name" "$srv_provider")" || return 1
}

srv_host_profile_manifest_write()
{
  [ "$#" -eq 1 ] || return 2
  srv_host_profile_manifest_file="$srv_host_manifest.profile"
  if [ -e "$srv_host_profile_manifest_file" ] || [ -L "$srv_host_profile_manifest_file" ]
  then
    [ -f "$srv_host_profile_manifest_file" ] && [ ! -L "$srv_host_profile_manifest_file" ] ||
      fatal 1 srv host-registration-invalid service "$srv_name" path "$srv_host_profile_manifest_file"
  fi

  srv_host_profile_manifest_tmp="$srv_host_profile_manifest_file.tmp.$$"
  [ ! -e "$srv_host_profile_manifest_tmp" ] && [ ! -L "$srv_host_profile_manifest_tmp" ] ||
    fatal 1 srv host-registration-write-failed service "$srv_name" path "$srv_host_profile_manifest_tmp"
  umask 077
  if ! printf 'm-srv-host-user-profile-v1\nsystem=%s\n' "$1" > "$srv_host_profile_manifest_tmp"
  then
    command -p -- rm -f -- "$srv_host_profile_manifest_tmp" 2>/dev/null
    fatal 1 srv host-registration-write-failed service "$srv_name" path "$srv_host_profile_manifest_file"
  fi
  command -p -- chmod 600 "$srv_host_profile_manifest_tmp" ||
    fatal 1 srv host-registration-write-failed service "$srv_name" path "$srv_host_profile_manifest_file"
  command -p -- mv -f -- "$srv_host_profile_manifest_tmp" "$srv_host_profile_manifest_file" ||
    fatal 1 srv host-registration-write-failed service "$srv_name" path "$srv_host_profile_manifest_file"
}

srv_host_profile_manifest_read()
{
  srv_host_profile_manifest_file="$srv_host_manifest.profile"
  [ -f "$srv_host_profile_manifest_file" ] && [ ! -L "$srv_host_profile_manifest_file" ] ||
    fatal 1 srv host-profile-registration-missing service "$srv_name"

  srv_host_profile_header=
  srv_host_profile_line=
  srv_host_profile_extra=
  {
    IFS= read -r srv_host_profile_header || fatal 2 srv host-profile-registration-invalid service "$srv_name"
    IFS= read -r srv_host_profile_line || fatal 2 srv host-profile-registration-invalid service "$srv_name"
    IFS= read -r srv_host_profile_extra
    srv_host_profile_read_status=$?
  } < "$srv_host_profile_manifest_file"
  [ "$srv_host_profile_read_status" -ne 0 ] && [ -z "$srv_host_profile_extra" ] ||
    fatal 2 srv host-profile-registration-invalid service "$srv_name"
  [ "$srv_host_profile_header" = m-srv-host-user-profile-v1 ] ||
    fatal 2 srv host-profile-registration-invalid service "$srv_name"
  case "$srv_host_profile_line" in
    system=*) srv_host_registered_profile=${srv_host_profile_line#system=} ;;
    *) fatal 2 srv host-profile-registration-invalid service "$srv_name" ;;
  esac
  [ -n "$srv_host_registered_profile" ] ||
    fatal 2 srv host-profile-registration-invalid service "$srv_name"
  context "system=$srv_host_registered_profile" || return $?
  [ "$m_CONTEXT_SYSTEM_PROFILE" = "$srv_host_registered_profile" ] ||
    fatal 2 srv host-profile-registration-invalid service "$srv_name"
}

srv_host_profile_capture()
{
  [ -n "${m_CONTEXT_ENVELOPE_VALIDATED-}" ] &&
  [ -n "${m_CONTEXT_SYSTEM_PROFILE-}" ] ||
    fatal 1 srv host-profile-registration-invalid service "$srv_name"
  srv_host_registered_profile=$m_CONTEXT_SYSTEM_PROFILE
  context "system=$srv_host_registered_profile" || return $?
  [ "$m_CONTEXT_SYSTEM_PROFILE" = "$srv_host_registered_profile" ] ||
    fatal 1 srv host-profile-registration-invalid service "$srv_name"
}

srv_host_profile_manifest_remove()
{
  srv_host_profile_manifest_file="$srv_host_manifest.profile"
  if [ ! -e "$srv_host_profile_manifest_file" ] && [ ! -L "$srv_host_profile_manifest_file" ]
  then
    return 0
  fi
  [ -f "$srv_host_profile_manifest_file" ] && [ ! -L "$srv_host_profile_manifest_file" ] ||
    return 1
  command -p -- rm -f -- "$srv_host_profile_manifest_file"
}

srv_host_user_run()
{
  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv
  srv_name=$1
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv service "$srv_name"

  srv_host_os="$(command -p -- uname -s 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-platform-unavailable service "$srv_name"
  case "$srv_host_os" in
    Linux) srv_host_systemd_prepare ;;
    Darwin) srv_host_launchd_prepare ;;
    *) fatal 1 execution execution-failed operation srv reason unsupported-host host "$srv_host_os" service "$srv_name" ;;
  esac
  srv_host_profile_manifest_read || return $?

  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  exec "$m_BOOTSTRAP_BIN" "$srv_command"
  fatal 1 execution execution-failed operation srv reason provider-exec-failed service "$srv_name"
}

srv_host_account_prepare()
{
  srv_host_uid="$(command -p -- id -u 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"
  case "$srv_host_uid" in
    "" | *[!0123456789]*) fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" ;;
  esac

  srv_host_user_name="$(command -p -- id -un 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"
  case "$srv_host_user_name" in
    "" | */* | *'
'*) fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" ;;
  esac
}

srv_host_home_validate()
{
  case "$srv_host_home" in
    /*) : ;;
    *) fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name" ;;
  esac
  [ -d "$srv_host_home" ] ||
    fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
}

srv_host_systemd_arg_write()
{
  [ "$#" -eq 1 ] || return 2

  printf '"'
  LC_ALL=C printf '%s' "$1" |
    command -p -- od -A n -t x1 |
    command -p -- awk '{
      for (i = 1; i <= NF; i++)
        printf "\\x%s", $i
    }' || return 1
  printf '"'
}

srv_host_systemd_call()
{
  [ "$#" -ge 1 ] || return 2

  HOME="$srv_host_home" \
  XDG_CONFIG_HOME="$srv_host_home/.config" \
  XDG_RUNTIME_DIR="$srv_host_runtime" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=$srv_host_runtime/bus" \
    "$srv_systemctl" --user "$@"
}

srv_host_systemd_prepare()
{
  srv_systemctl="$(command -p -v systemctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"
  srv_getent="$(command -p -v getent 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"

  srv_host_account_prepare
  srv_host_home="$(
    "$srv_getent" passwd "$srv_host_uid" 2>/dev/null |
      command -p -- awk -F: -v uid="$srv_host_uid" '$3 == uid { print $6; exit }'
  )" || fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
  srv_host_home_validate

  srv_host_runtime="/run/user/$srv_host_uid"
  [ -d "$srv_host_runtime" ] ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"
  srv_host_systemd_call show-environment >/dev/null 2>&1 ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"

  srv_host_unit="m-srv-$srv_name.service"
  srv_host_dir="$srv_host_home/.config/systemd/user"
  srv_host_manifest="$srv_host_dir/$srv_host_unit"
}

srv_host_systemd_install()
{
  srv_host_profile_capture || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  command -p -- mkdir -p -- "$srv_host_dir" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi
  srv_host_tmp="$srv_host_manifest.tmp.$$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  umask 077
  (
    printf '%s\n' '[Unit]'
    printf 'Description=m user service %s\n' "$srv_name"
    printf '%s\n' ''
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf '%s' 'ExecStart=/bin/sh '
    srv_host_systemd_arg_write "$m_BOOTSTRAP_BIN" || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_host_command_bin" || exit 1
    printf ' '
    srv_host_systemd_arg_write '--host-user-run' || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_name" || exit 1
    printf '\n\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=default.target'
  ) > "$srv_host_tmp" || {
    command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  }

  command -p -- chmod 600 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  command -p -- mv -- "$srv_host_tmp" "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  srv_host_profile_manifest_write "$srv_host_registered_profile"

  srv_host_systemd_call daemon-reload ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  if ! srv_host_systemd_call enable "$srv_host_unit"
  then
    command -p -- rm -f -- "$srv_host_manifest" 2>/dev/null
    srv_host_profile_manifest_remove >/dev/null 2>&1 || :
    srv_host_systemd_call daemon-reload >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
}

srv_host_systemd_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_systemd_start()
{
  srv_host_systemd_manifest_require
  srv_host_profile_manifest_read || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_host_systemd_call start "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
}

srv_host_systemd_stop()
{
  srv_host_systemd_manifest_require
  srv_host_systemd_call stop "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_systemd_restart()
{
  srv_host_systemd_manifest_require
  srv_host_profile_manifest_read || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_host_systemd_call restart "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
}

srv_host_systemd_uninstall()
{
  if [ ! -e "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ]
  then
    srv_host_profile_manifest_remove ||
      fatal 1 srv host-registration-remove-failed service "$srv_name"
    return 0
  fi
  srv_host_systemd_manifest_require

  srv_host_systemd_call stop "$srv_host_unit" >/dev/null 2>&1 || :
  srv_host_systemd_call disable "$srv_host_unit" >/dev/null 2>&1 || :
  command -p -- rm -f -- "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
  srv_host_profile_manifest_remove ||
    fatal 1 srv host-registration-remove-failed service "$srv_name"
  srv_host_systemd_call daemon-reload ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
}

srv_host_launchd_prepare()
{
  srv_launchctl="$(command -p -v launchctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"
  srv_plutil="$(command -p -v plutil 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"
  srv_dscl="$(command -p -v dscl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"

  srv_host_account_prepare
  srv_host_domain="gui/$srv_host_uid"
  "$srv_launchctl" print "$srv_host_domain" >/dev/null 2>&1 ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"

  srv_host_home="$(
    "$srv_dscl" . -read "/Users/$srv_host_user_name" NFSHomeDirectory 2>/dev/null |
      command -p -- sed -n 's/^NFSHomeDirectory: //p' |
      command -p -- sed -n '1p'
  )" || fatal 1 execution execution-failed operation srv reason host-home-unavailable service "$srv_name"
  srv_host_home_validate

  srv_host_label="m.srv.$srv_name"
  srv_host_dir="$srv_host_home/Library/LaunchAgents"
  srv_host_manifest="$srv_host_dir/$srv_host_label.plist"
  srv_host_target="$srv_host_domain/$srv_host_label"
}

srv_host_launchd_install()
{
  srv_host_profile_capture || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  command -p -- mkdir -p -- "$srv_host_dir" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi

  srv_host_tmp="$srv_host_manifest.tmp.$$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  "$srv_plutil" -create xml1 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  "$srv_plutil" -insert Label -string "$srv_host_label" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments -array "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.0 -string "$m_BOOTSTRAP_BIN" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.1 -string "$srv_host_command_bin" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.2 -string '--host-user-run' "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.3 -string "$srv_name" "$srv_host_tmp" &&
  "$srv_plutil" -insert RunAtLoad -bool true "$srv_host_tmp" ||
    {
      command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
      fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
    }

  command -p -- chmod 600 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  command -p -- mv -- "$srv_host_tmp" "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  srv_host_profile_manifest_write "$srv_host_registered_profile"

  if ! "$srv_launchctl" enable "$srv_host_target"
  then
    command -p -- rm -f -- "$srv_host_manifest" 2>/dev/null
    srv_host_profile_manifest_remove >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
}

srv_host_launchd_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_launchd_loaded()
{
  "$srv_launchctl" print "$srv_host_target" >/dev/null 2>&1
}

srv_host_launchd_wait_unloaded()
{
  srv_host_wait=0
  while srv_host_launchd_loaded && [ "$srv_host_wait" -lt 10 ]
  do
    command -p -- sleep 1
    srv_host_wait=$((srv_host_wait + 1))
  done
  ! srv_host_launchd_loaded
}

srv_host_launchd_start()
{
  srv_host_launchd_manifest_require
  srv_host_profile_manifest_read || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" kickstart "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  else
    "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  fi
}

srv_host_launchd_stop()
{
  srv_host_launchd_manifest_require
  srv_host_launchd_loaded || return 0

  "$srv_launchctl" bootout "$srv_host_target" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
  srv_host_launchd_wait_unloaded ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_launchd_restart()
{
  srv_host_launchd_manifest_require
  srv_host_profile_manifest_read || return $?
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" kickstart -k "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
  else
    "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
  fi
}

srv_host_launchd_uninstall()
{
  if [ ! -e "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ]
  then
    srv_host_profile_manifest_remove ||
      fatal 1 srv host-registration-remove-failed service "$srv_name"
    "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :
    return 0
  fi
  srv_host_launchd_manifest_require

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" bootout "$srv_host_target" >/dev/null 2>&1 || :
    srv_host_launchd_wait_unloaded ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
  fi

  command -p -- rm -f -- "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
  srv_host_profile_manifest_remove ||
    fatal 1 srv host-registration-remove-failed service "$srv_name"
  "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :
}

srv_host_user()
{
  [ "$#" -eq 2 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_action=$1
  srv_name=$2
  srv_name_valid "$srv_name" ||
    fatal 2 execution invalid-arguments operation srv subcommand host service "$srv_name"

  srv_host_os="$(command -p -- uname -s 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-platform-unavailable service "$srv_name"

  case "$srv_host_os" in
    Linux)
      srv_host_systemd_prepare
      case "$srv_host_action" in
        install) srv_host_systemd_install ;;
        uninstall) srv_host_systemd_uninstall ;;
        start) srv_host_systemd_start ;;
        stop) srv_host_systemd_stop ;;
        restart) srv_host_systemd_restart ;;
        *) fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action" ;;
      esac
      ;;
    Darwin)
      srv_host_launchd_prepare
      case "$srv_host_action" in
        install) srv_host_launchd_install ;;
        uninstall) srv_host_launchd_uninstall ;;
        start) srv_host_launchd_start ;;
        stop) srv_host_launchd_stop ;;
        restart) srv_host_launchd_restart ;;
        *) fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action" ;;
      esac
      ;;
    *)
      fatal 1 execution execution-failed operation srv reason unsupported-host host "$srv_host_os" service "$srv_name"
      ;;
  esac
}


srv_host_system_admin_require()
{
  srv_host_admin_uid="$(command -p -- id -u 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-administration-required service "$srv_name"
  [ "$srv_host_admin_uid" = 0 ] ||
    fatal 1 execution execution-failed operation srv reason host-administration-required service "$srv_name"
}

srv_host_system_account_prepare()
{
  [ "$#" -eq 1 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_account=$1

  case "$srv_host_account" in
    "" | [!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
      fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" account "$srv_host_account"
      ;;
  esac

  srv_host_account_uid="$(command -p -- id -u "$srv_host_account" 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" account "$srv_host_account"
  case "$srv_host_account_uid" in
    "" | *[!0123456789]* | 0)
      fatal 1 execution execution-failed operation srv reason host-account-invalid service "$srv_name" account "$srv_host_account"
      ;;
  esac

  srv_host_account_canonical="$(command -p -- id -un "$srv_host_account_uid" 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name" account "$srv_host_account"
  [ "$srv_host_account_canonical" = "$srv_host_account" ] ||
    fatal 1 execution execution-failed operation srv reason host-account-invalid service "$srv_name" account "$srv_host_account"
}

srv_host_system_provider_prepare()
{
  srv_host_provider_resolve "$srv_name" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"

  _pkg_provider_concrete_parse "$srv_provider" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  srv_host_provider_package=$pkg_provider_concrete_pkg

  pkg_provider_global_runtime_access_prepare ||
    fatal 1 execution execution-failed operation srv reason provider-runtime-access-failed service "$srv_name"
  pkg_dependency_runtime_access_prepare "$srv_provider" ||
    fatal 1 execution execution-failed operation srv reason dependency-runtime-access-failed service "$srv_name" provider "$srv_provider"
}

srv_host_system_state_prepare()
{
  srv_host_service_home="$(command -- state-path system pkg "$srv_host_provider_package" home "$srv_name")" ||
    fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"
  srv_host_service_identity=${srv_host_service_home%/home}
  srv_host_service_pkg_root=${srv_host_service_identity%/*}
  [ "$srv_host_service_identity" != "$srv_host_service_home" ] &&
  [ "$srv_host_service_pkg_root" != "$srv_host_service_identity" ] ||
    fatal 1 execution execution-failed operation srv reason state-unavailable service "$srv_name"

  srv_host_service_home_existed=0
  if [ -e "$srv_host_service_home" ] || [ -L "$srv_host_service_home" ]
  then
    srv_host_service_home_existed=1
    [ -d "$srv_host_service_home" ] && [ ! -L "$srv_host_service_home" ] ||
      fatal 1 execution execution-failed operation srv reason state-invalid service "$srv_name"
  fi

  umask 077
  command -p -- mkdir -p -- "$srv_host_service_identity" ||
    fatal 1 execution execution-failed operation srv reason state-create-failed service "$srv_name"

  for srv_host_service_traverse in "$srv_host_service_pkg_root" "$srv_host_service_identity"
  do
    [ -d "$srv_host_service_traverse" ] && [ ! -L "$srv_host_service_traverse" ] ||
      fatal 1 execution execution-failed operation srv reason state-invalid service "$srv_name"
    command -p -- chmod 711 "$srv_host_service_traverse" ||
      fatal 1 execution execution-failed operation srv reason state-permission-failed service "$srv_name"
  done

  if [ "$srv_host_service_home_existed" -eq 0 ]
  then
    command -p -- mkdir -- "$srv_host_service_home" ||
      fatal 1 execution execution-failed operation srv reason state-create-failed service "$srv_name"
    command -p -- chown "$srv_host_account_uid" "$srv_host_service_home" ||
      fatal 1 execution execution-failed operation srv reason state-owner-failed service "$srv_name"
    command -p -- chmod 700 "$srv_host_service_home" ||
      fatal 1 execution execution-failed operation srv reason state-permission-failed service "$srv_name"
  else
    srv_host_service_home_uid="$(
      command -p -- ls -dn "$srv_host_service_home" 2>/dev/null |
        command -p -- awk 'NR == 1 { print $3 }'
    )" || fatal 1 execution execution-failed operation srv reason state-owner-unavailable service "$srv_name"
    [ "$srv_host_service_home_uid" = "$srv_host_account_uid" ] ||
      fatal 1 execution execution-failed operation srv reason state-owner-mismatch service "$srv_name" account "$srv_host_account"
  fi
}

srv_host_system_registration_prepare()
{
  srv_host_system_registration_dir="$m_STATE_DIR/system/srv/conf/system"
  srv_host_system_registration_file="$srv_host_system_registration_dir/$srv_name"
}

srv_host_system_registration_ancestor_validate()
{
  [ "$#" -eq 2 ] || return 2
  srv_host_system_ancestor_path=$1
  srv_host_system_ancestor_owner=$2
  [ -d "$srv_host_system_ancestor_path" ] && [ ! -L "$srv_host_system_ancestor_path" ] || return 1
  command -p -- ls -ldn "$srv_host_system_ancestor_path" 2>/dev/null |
    LC_ALL=C command -p -- awk -v owner="$srv_host_system_ancestor_owner" \
      'NR == 1 && substr($1, 1, 1) == "d" && substr($1, 6, 1) != "w" && substr($1, 9, 1) != "w" && substr($1, 11) !~ /[^@]/ && ($3 == "0" || $3 == owner) { ok = 1 } END { if (!ok) exit 1 }'
}

srv_host_system_registration_child_validate()
{
  [ "$#" -eq 1 ] || return 2
  srv_host_system_child_path=$1
  [ -d "$srv_host_system_child_path" ] && [ ! -L "$srv_host_system_child_path" ] || return 1
  command -p -- ls -ldn "$srv_host_system_child_path" 2>/dev/null |
    LC_ALL=C command -p -- awk 'NR == 1 && substr($1, 1, 1) == "d" && substr($1, 6, 1) != "w" && substr($1, 9, 1) != "w" && substr($1, 11) !~ /[^@]/ && $3 == "0" { ok = 1 } END { if (!ok) exit 1 }'
}

srv_host_system_registration_write()
{
  srv_host_system_registration_prepare
  srv_host_system_registered_profile=${srv_host_registered_profile:-${m_CONTEXT_SYSTEM_PROFILE-}}
  [ -n "$srv_host_system_registered_profile" ] || return 1
  umask 077
  srv_host_system_root_owner="$(command -p -- ls -ldn "$m_ROOT" 2>/dev/null | command -p -- awk 'NR == 1 { print $3 }')" || return 1
  srv_host_system_registration_ancestor_validate "$m_STATE_DIR" "$srv_host_system_root_owner" || return 1
  srv_host_system_registration_ancestor_validate "$m_STATE_DIR/system" "$srv_host_system_root_owner" || return 1
  for srv_host_system_registration_parent in \
    "$m_STATE_DIR/system/srv" \
    "$m_STATE_DIR/system/srv/conf" \
    "$srv_host_system_registration_dir"
  do
    if [ ! -e "$srv_host_system_registration_parent" ] && [ ! -L "$srv_host_system_registration_parent" ]
    then
      command -p -- mkdir -- "$srv_host_system_registration_parent" || return 1
      command -p -- chown 0:0 "$srv_host_system_registration_parent" &&
      command -p -- chmod 755 "$srv_host_system_registration_parent" || return 1
    fi
    srv_host_system_registration_child_validate "$srv_host_system_registration_parent" || return 1
  done
  if [ -e "$srv_host_system_registration_file" ] || [ -L "$srv_host_system_registration_file" ]
  then
    [ -f "$srv_host_system_registration_file" ] && [ ! -L "$srv_host_system_registration_file" ] || return 1
  fi

  srv_host_system_registration_tmp="$srv_host_system_registration_dir/.$srv_name.$$"
  [ ! -e "$srv_host_system_registration_tmp" ] && [ ! -L "$srv_host_system_registration_tmp" ] || return 1

  if ! printf '%s\n' \
    m-srv-host-system-registration-v1 \
    "account=$srv_host_account" \
    "system=$srv_host_system_registered_profile" \
    "provider=$srv_provider" > "$srv_host_system_registration_tmp"
  then
    command -p -- rm -f -- "$srv_host_system_registration_tmp" 2>/dev/null
    return 1
  fi
  if ! command -p -- chmod 644 "$srv_host_system_registration_tmp" ||
     ! command -p -- chown 0:0 "$srv_host_system_registration_tmp" ||
     ! command -p -- mv -f -- "$srv_host_system_registration_tmp" "$srv_host_system_registration_file"
  then
    command -p -- rm -f -- "$srv_host_system_registration_tmp" 2>/dev/null || :
    return 1
  fi
}

srv_host_system_registration_read()
{
  srv_host_system_registration_prepare
  srv_host_system_root_owner="$(command -p -- ls -ldn "$m_ROOT" 2>/dev/null | command -p -- awk 'NR == 1 { print $3 }')" || return 1
  srv_host_system_registration_ancestor_validate "$m_STATE_DIR" "$srv_host_system_root_owner" || return 1
  srv_host_system_registration_ancestor_validate "$m_STATE_DIR/system" "$srv_host_system_root_owner" || return 1
  for srv_host_system_registration_parent in \
    "$m_STATE_DIR/system/srv" \
    "$m_STATE_DIR/system/srv/conf" \
    "$srv_host_system_registration_dir"
  do
    srv_host_system_registration_child_validate "$srv_host_system_registration_parent" || return 1
  done
  [ -f "$srv_host_system_registration_file" ] && [ ! -L "$srv_host_system_registration_file" ] &&
  [ -r "$srv_host_system_registration_file" ] ||
    return 1
  command -p -- ls -ldn "$srv_host_system_registration_file" 2>/dev/null |
    LC_ALL=C command -p -- awk 'NR == 1 && substr($1, 1, 1) == "-" && substr($1, 6, 1) != "w" && substr($1, 9, 1) != "w" && substr($1, 11) !~ /[^@]/ && $3 == "0" { ok = 1 } END { if (!ok) exit 1 }' ||
      return 1

  srv_host_registered_header=
  srv_host_registered_account_line=
  srv_host_registered_system_line=
  srv_host_registered_provider_line=
  srv_host_registered_extra=
  {
    IFS= read -r srv_host_registered_header || return 1
    IFS= read -r srv_host_registered_account_line || return 1
    IFS= read -r srv_host_registered_system_line || return 1
    IFS= read -r srv_host_registered_provider_line || return 1
    IFS= read -r srv_host_registered_extra
    srv_host_registered_second_status=$?
  } < "$srv_host_system_registration_file"
  [ "$srv_host_registered_second_status" -ne 0 ] || return 1
  [ -z "$srv_host_registered_extra" ] || return 1
  [ "$srv_host_registered_header" = m-srv-host-system-registration-v1 ] || return 1
  case "$srv_host_registered_account_line" in account=*) srv_host_registered_account=${srv_host_registered_account_line#account=} ;; *) return 1 ;; esac
  case "$srv_host_registered_system_line" in system=*) srv_host_registered_profile=${srv_host_registered_system_line#system=} ;; *) return 1 ;; esac
  case "$srv_host_registered_provider_line" in provider=*) srv_host_registered_provider=${srv_host_registered_provider_line#provider=} ;; *) return 1 ;; esac

  case "$srv_host_registered_account" in
    "" | [!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
  esac
  [ -n "$srv_host_registered_profile" ] || return 1
  _pkg_provider_concrete_parse "$srv_host_registered_provider" || return 1
  context "system=$srv_host_registered_profile" || return 1
}

srv_host_system_registration_remove()
{
  srv_host_system_registration_prepare
  if [ ! -e "$srv_host_system_registration_file" ] && [ ! -L "$srv_host_system_registration_file" ]
  then
    return 0
  fi
  [ -f "$srv_host_system_registration_file" ] && [ ! -L "$srv_host_system_registration_file" ] ||
    return 1
  command -p -- rm -f -- "$srv_host_system_registration_file"
}

srv_host_system_manifest_backup()
{
  srv_host_system_manifest_existed=0
  srv_host_system_manifest_backup_file="$srv_host_manifest.rollback.$$"
  [ ! -e "$srv_host_system_manifest_backup_file" ] && [ ! -L "$srv_host_system_manifest_backup_file" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
    command -p -- cp "$srv_host_manifest" "$srv_host_system_manifest_backup_file" ||
      fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
    srv_host_system_manifest_existed=1
  fi
}

srv_host_system_manifest_restore()
{
  if [ "$srv_host_system_manifest_existed" -eq 1 ]
  then
    command -p -- mv -f -- "$srv_host_system_manifest_backup_file" "$srv_host_manifest" || return 1
    command -p -- chmod 644 "$srv_host_manifest" || return 1
    command -p -- chown 0:0 "$srv_host_manifest" || return 1
  else
    command -p -- rm -f -- "$srv_host_manifest" || return 1
  fi
}

srv_host_system_registration_current_require()
{
  srv_host_system_registration_read ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"

  srv_host_current_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  [ "$srv_host_current_provider" = "$srv_host_registered_provider" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-stale service "$srv_name" provider "$srv_host_registered_provider" current "$srv_host_current_provider"

  pkg_facility_service_start_resolve "$srv_name" "$srv_host_current_provider" >/dev/null ||
    fatal 1 execution execution-failed operation srv reason service-realization-invalid service "$srv_name" provider "$srv_host_current_provider"
}

srv_host_system_run()
{
  [ "$#" -eq 2 ] || fatal 2 execution invalid-arguments operation srv
  srv_name=$1
  srv_host_expected_provider=$2
  srv_name_valid "$srv_name" || fatal 2 execution invalid-arguments operation srv service "$srv_name"
  _pkg_provider_concrete_parse "$srv_host_expected_provider" ||
    fatal 2 execution invalid-arguments operation srv service "$srv_name"
  srv_host_provider_package=$pkg_provider_concrete_pkg

  srv_host_system_registration_read ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
  [ "$srv_host_registered_provider" = "$srv_host_expected_provider" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-stale service "$srv_name" provider "$srv_host_expected_provider" current "$srv_host_registered_provider"
  srv_host_system_account_prepare "$srv_host_registered_account"
  srv_host_actual_uid="$(command -p -- id -u 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-account-unavailable service "$srv_name"
  [ "$srv_host_actual_uid" = "$srv_host_account_uid" ] ||
    fatal 1 execution execution-failed operation srv reason host-account-mismatch service "$srv_name" account "$srv_host_registered_account"

  srv_host_current_provider="$(pkg_provider_default_resolve "$srv_name" 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason provider-resolution-failed service "$srv_name"
  [ "$srv_host_current_provider" = "$srv_host_expected_provider" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-stale service "$srv_name" provider "$srv_host_expected_provider" current "$srv_host_current_provider"

  srv_command="$(pkg_facility_service_start_resolve "$srv_name" "$srv_host_expected_provider")" ||
    fatal 1 execution execution-failed operation srv reason service-realization-invalid service "$srv_name" provider "$srv_host_expected_provider"

  m_PKG_LAUNCH_CONTEXT=system-service
  m_PKG_LAUNCH_STATE_INSTANCE=$srv_name
  export m_PKG_LAUNCH_CONTEXT m_PKG_LAUNCH_STATE_INSTANCE

  exec "$m_BOOTSTRAP_BIN" "$srv_command"
  fatal 1 execution execution-failed operation srv reason provider-exec-failed service "$srv_name"
}

srv_host_systemd_system_call()
{
  [ "$#" -ge 1 ] || return 2
  "$srv_systemctl" "$@"
}

srv_host_systemd_system_prepare()
{
  srv_systemctl="$(command -p -v systemctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host systemd service "$srv_name"
  srv_host_unit="m-srv-$srv_name.service"
  srv_host_dir=/etc/systemd/system
  srv_host_manifest="$srv_host_dir/$srv_host_unit"
}

srv_host_systemd_system_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_systemd_system_install()
{
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi

  srv_host_tmp="$srv_host_manifest.tmp.$$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  umask 077
  (
    printf '%s\n' '[Unit]'
    printf 'Description=m system service %s\n' "$srv_name"
    printf '%s\n' ''
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf 'User=%s\n' "$srv_host_account"
    printf '%s' 'ExecStart=/bin/sh '
    srv_host_systemd_arg_write "$m_BOOTSTRAP_BIN" || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_host_command_bin" || exit 1
    printf ' '
    srv_host_systemd_arg_write '--host-system-run' || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_name" || exit 1
    printf ' '
    srv_host_systemd_arg_write "$srv_provider" || exit 1
    printf '\n\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=multi-user.target'
  ) > "$srv_host_tmp" || {
    command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  }

  command -p -- chmod 644 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  srv_host_system_manifest_backup
  if ! command -p -- mv -f -- "$srv_host_tmp" "$srv_host_manifest"
  then
    command -p -- rm -f -- "$srv_host_tmp" "$srv_host_system_manifest_backup_file" 2>/dev/null || :
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  fi

  if ! srv_host_systemd_system_call daemon-reload
  then
    srv_host_system_manifest_restore || :
    srv_host_systemd_system_call daemon-reload >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
  if ! srv_host_systemd_system_call enable "$srv_host_unit"
  then
    if [ "$srv_host_system_manifest_existed" -eq 0 ]; then srv_host_systemd_system_call disable "$srv_host_unit" >/dev/null 2>&1 || :; fi
    srv_host_system_manifest_restore || :
    srv_host_systemd_system_call daemon-reload >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
  if ! srv_host_system_registration_write
  then
    if [ "$srv_host_system_manifest_existed" -eq 0 ]; then srv_host_systemd_system_call disable "$srv_host_unit" >/dev/null 2>&1 || :; fi
    srv_host_system_manifest_restore || :
    srv_host_systemd_system_call daemon-reload >/dev/null 2>&1 || :
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  fi
  command -p -- rm -f -- "$srv_host_system_manifest_backup_file"
}

srv_host_systemd_system_start()
{
  srv_host_systemd_system_manifest_require
  srv_host_system_registration_current_require
  srv_host_systemd_system_call start "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
}

srv_host_systemd_system_stop()
{
  srv_host_systemd_system_manifest_require
  srv_host_systemd_system_call stop "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_systemd_system_restart()
{
  srv_host_systemd_system_manifest_require
  srv_host_system_registration_current_require
  srv_host_systemd_system_call restart "$srv_host_unit" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
}

srv_host_systemd_system_uninstall()
{
  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    srv_host_systemd_system_manifest_require
    srv_host_systemd_system_call stop "$srv_host_unit" >/dev/null 2>&1 || :
    srv_host_systemd_system_call disable "$srv_host_unit" >/dev/null 2>&1 || :
    command -p -- rm -f -- "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
    srv_host_systemd_system_call daemon-reload ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
  fi

  srv_host_system_registration_remove ||
    fatal 1 execution execution-failed operation srv reason state-cleanup-failed service "$srv_name"
}

srv_host_launchd_system_prepare()
{
  srv_launchctl="$(command -p -v launchctl 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"
  srv_plutil="$(command -p -v plutil 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-unavailable host launchd service "$srv_name"

  srv_host_label="m.srv.$srv_name"
  srv_host_domain=system
  srv_host_dir=/Library/LaunchDaemons
  srv_host_manifest="$srv_host_dir/$srv_host_label.plist"
  srv_host_target="$srv_host_domain/$srv_host_label"
}

srv_host_launchd_system_manifest_require()
{
  [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-missing service "$srv_name"
}

srv_host_launchd_system_install()
{
  [ -d "$srv_host_dir" ] && [ ! -L "$srv_host_dir" ] ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"

  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    [ -f "$srv_host_manifest" ] && [ ! -L "$srv_host_manifest" ] ||
      fatal 1 execution execution-failed operation srv reason host-registration-invalid service "$srv_name"
  fi
  srv_host_tmp="$srv_host_manifest.tmp.$$"
  command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
  "$srv_plutil" -create xml1 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  "$srv_plutil" -insert Label -string "$srv_host_label" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments -array "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.0 -string "$m_BOOTSTRAP_BIN" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.1 -string "$srv_host_command_bin" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.2 -string '--host-system-run' "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.3 -string "$srv_name" "$srv_host_tmp" &&
  "$srv_plutil" -insert ProgramArguments.4 -string "$srv_provider" "$srv_host_tmp" &&
  "$srv_plutil" -insert UserName -string "$srv_host_account" "$srv_host_tmp" &&
  "$srv_plutil" -insert RunAtLoad -bool true "$srv_host_tmp" ||
    {
      command -p -- rm -f -- "$srv_host_tmp" 2>/dev/null
      fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
    }

  command -p -- chmod 644 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  command -p -- chown 0:0 "$srv_host_tmp" ||
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  srv_host_system_manifest_backup
  if ! command -p -- mv -f -- "$srv_host_tmp" "$srv_host_manifest"
  then
    command -p -- rm -f -- "$srv_host_tmp" "$srv_host_system_manifest_backup_file" 2>/dev/null || :
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  fi

  if ! "$srv_launchctl" enable "$srv_host_target"
  then
    if [ "$srv_host_system_manifest_existed" -eq 0 ]; then "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :; fi
    srv_host_system_manifest_restore || :
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action install service "$srv_name"
  fi
  if ! srv_host_system_registration_write
  then
    if [ "$srv_host_system_manifest_existed" -eq 0 ]; then "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :; fi
    srv_host_system_manifest_restore || :
    fatal 1 execution execution-failed operation srv reason host-registration-write-failed service "$srv_name"
  fi
  command -p -- rm -f -- "$srv_host_system_manifest_backup_file"
}

srv_host_launchd_system_start()
{
  srv_host_launchd_system_manifest_require
  srv_host_system_registration_current_require

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" kickstart "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  else
    "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action start service "$srv_name"
  fi
}

srv_host_launchd_system_stop()
{
  srv_host_launchd_system_manifest_require
  srv_host_launchd_loaded || return 0

  "$srv_launchctl" bootout "$srv_host_target" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
  srv_host_launchd_wait_unloaded ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action stop service "$srv_name"
}

srv_host_launchd_system_restart()
{
  srv_host_launchd_system_manifest_require
  srv_host_system_registration_current_require

  if srv_host_launchd_loaded
  then
    "$srv_launchctl" bootout "$srv_host_target" ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
    srv_host_launchd_wait_unloaded ||
      fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
  fi

  "$srv_launchctl" bootstrap "$srv_host_domain" "$srv_host_manifest" ||
    fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action restart service "$srv_name"
}

srv_host_launchd_system_uninstall()
{
  if [ -e "$srv_host_manifest" ] || [ -L "$srv_host_manifest" ]
  then
    srv_host_launchd_system_manifest_require
    if srv_host_launchd_loaded
    then
      "$srv_launchctl" bootout "$srv_host_target" >/dev/null 2>&1 || :
      srv_host_launchd_wait_unloaded ||
        fatal 1 execution execution-failed operation srv reason host-supervisor-operation-failed action uninstall service "$srv_name"
    fi
    command -p -- rm -f -- "$srv_host_manifest" ||
      fatal 1 execution execution-failed operation srv reason host-registration-remove-failed service "$srv_name"
  fi

  "$srv_launchctl" disable "$srv_host_target" >/dev/null 2>&1 || :
  srv_host_system_registration_remove ||
    fatal 1 execution execution-failed operation srv reason state-cleanup-failed service "$srv_name"
}

srv_host_system()
{
  [ "$#" -ge 2 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_action=$1
  srv_name=$2
  srv_name_valid "$srv_name" ||
    fatal 2 execution invalid-arguments operation srv subcommand host service "$srv_name"

  case "$srv_host_action" in
    install)
      [ "$#" -eq 3 ] || fatal 2 execution invalid-arguments operation srv subcommand host action install
      ;;
    uninstall | start | stop | restart)
      [ "$#" -eq 2 ] || fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action"
      ;;
    *)
      fatal 2 execution invalid-arguments operation srv subcommand host action "$srv_host_action"
      ;;
  esac

  srv_host_system_admin_require

  if [ "$srv_host_action" = install ]
  then
    srv_host_profile_capture || return $?
    srv_host_system_account_prepare "$3"
    srv_host_system_provider_prepare
    srv_host_system_state_prepare
  fi

  srv_host_os="$(command -p -- uname -s 2>/dev/null)" ||
    fatal 1 execution execution-failed operation srv reason host-platform-unavailable service "$srv_name"

  case "$srv_host_os" in
    Linux)
      srv_host_systemd_system_prepare
      case "$srv_host_action" in
        install) srv_host_systemd_system_install ;;
        uninstall) srv_host_systemd_system_uninstall ;;
        start) srv_host_systemd_system_start ;;
        stop) srv_host_systemd_system_stop ;;
        restart) srv_host_systemd_system_restart ;;
      esac
      ;;
    Darwin)
      srv_host_launchd_system_prepare
      case "$srv_host_action" in
        install) srv_host_launchd_system_install ;;
        uninstall) srv_host_launchd_system_uninstall ;;
        start) srv_host_launchd_system_start ;;
        stop) srv_host_launchd_system_stop ;;
        restart) srv_host_launchd_system_restart ;;
      esac
      ;;
    *)
      fatal 1 execution execution-failed operation srv reason unsupported-host host "$srv_host_os" service "$srv_name"
      ;;
  esac
}

srv_host()
{
  [ "$#" -ge 1 ] || fatal 2 execution invalid-arguments operation srv subcommand host
  srv_host_scope=$1
  shift

  if [ "${1-}" = install ]
  then
    readpathce srv_host_command_bin "$0" ||
      fatal 1 srv host-command-resolution-failed command "$0"
  fi

  case "$srv_host_scope" in
    user) srv_host_user "$@" ;;
    system) srv_host_system "$@" ;;
    *) fatal 2 execution invalid-arguments operation srv subcommand host scope "$srv_host_scope" ;;
  esac
}

[ "$#" -ge 1 ] || fatal 2 execution invalid-arguments operation srv

srv_subcommand=$1
shift

case "$srv_subcommand" in
  start)
    srv_start "$@"
    ;;
  stop)
    srv_stop "$@"
    ;;
  host)
    srv_host "$@"
    ;;
  --host-user-run)
    srv_host_user_run "$@"
    ;;
  --host-system-run)
    srv_host_system_run "$@"
    ;;
  *)
    fatal 2 execution invalid-arguments operation srv subcommand "$srv_subcommand"
    ;;
esac
